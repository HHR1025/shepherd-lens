{
  "name": "shepherd-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:extension": "vite build --config vite.extension.config.ts && vite build --config vite.background.config.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:calibration": "vitest run extension/src/measurement-calibration.test.ts",
    "test:validation": "vitest run extension/src/measurement-validation-study.test.ts",
    "test:extension:e2e": "npm run build:extension && playwright test --config playwright.extension.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:extension"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.1.42",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "framer-motion": "^12.43.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.2.1",
    "vitest": "^4.1.8"
  }
}
