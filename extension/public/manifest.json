{
  "manifest_version": 3,
  "name": "Shepherd Lens",
  "description": "See how algorithms shape your attention.",
  "version": "0.1.0",
  "action": {
    "default_title": "Shepherd Lens"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.crossref.org/*",
    "https://api.gdeltproject.org/*",
    "https://en.wikipedia.org/*",
    "https://zh.wikipedia.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://youtube.com/*", "https://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
